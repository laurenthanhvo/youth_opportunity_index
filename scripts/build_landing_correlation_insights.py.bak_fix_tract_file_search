from pathlib import Path
import itertools
import json
import math
import re

import pandas as pd


ROOT = Path(__file__).resolve().parents[1]
YOI_DIR = ROOT / "data" / "processed" / "yoi"
OUT = ROOT / "data" / "processed" / "landing" / "landing_correlation_insights.json"


DOMAIN_DEFS = {
    "Economic": ["economic_0_100", "economic_score", "economic"],
    "Education": ["education_0_100", "education_score", "education"],
    "Health": ["health_0_100", "health_score", "health"],
    "Housing": ["housing_0_100", "housing_score", "housing"],
    "Safety / Env": [
        "safety_env_0_100",
        "safety_environment_0_100",
        "safety_0_100",
        "environment_0_100",
        "safety",
        "environment",
    ],
    "Mobility / Connectivity": [
        "mobility_connectivity_0_100",
        "mobility_0_100",
        "connectivity_0_100",
        "mobility",
        "connectivity",
    ],
    "Youth Supports": [
        "youth_supports_0_100",
        "youth_support_0_100",
        "youthsupports_0_100",
        "youth_supports",
        "youth_support",
    ],
}


def norm(text):
    return re.sub(r"[^a-z0-9]+", "", str(text).lower())


def pretty_label(col):
    s = str(col)
    s = re.sub(r"_?0_100$", "", s)
    s = re.sub(r"_?score$", "", s)
    s = s.replace("_", " ").replace("-", " ")
    s = re.sub(r"\s+", " ", s).strip().title()

    replacements = {
        "Yoi": "YOI",
        "Coi": "COI",
        "Acs": "ACS",
        "Pums": "PUMS",
        "Pct": "%",
        "Percent": "%",
        "14 24": "14–24",
        "16 19": "16–19",
        "18 24": "18–24",
        "Env": "Environmental",
    }

    for old, new in replacements.items():
        s = s.replace(old, new)

    return s


def find_tract_file():
    if not YOI_DIR.exists():
        raise FileNotFoundError(f"Could not find {YOI_DIR}")

    candidates = []

    for path in sorted(YOI_DIR.glob("*.csv")):
        try:
            sample = pd.read_csv(path, nrows=50)
        except Exception:
            continue

        cols = [c.lower() for c in sample.columns]
        has_overall = any("overall" in c and ("yoi" in c or "100" in c or "score" in c) for c in cols)
        has_tract = any("tract" in c or "geoid" in c for c in cols)

        if not has_overall:
            continue

        score = 0
        score += 100 if has_overall else 0
        score += 50 if has_tract else 0
        score += 20 if "tract" in path.name.lower() else 0
        score += 10 if "component" in path.name.lower() else 0
        score += min(30, len(sample.columns))

        candidates.append((score, path))

    if not candidates:
        raise RuntimeError(
            "Could not find a tract-level YOI CSV in data/processed/yoi. "
            "Expected a file with an overall YOI column."
        )

    candidates.sort(reverse=True)
    return candidates[0][1]


def find_col(df, exact_candidates=None, contains_all=None, contains_any=None):
    exact_candidates = exact_candidates or []
    contains_all = contains_all or []
    contains_any = contains_any or []

    col_by_norm = {norm(c): c for c in df.columns}

    for candidate in exact_candidates:
        if norm(candidate) in col_by_norm:
            return col_by_norm[norm(candidate)]

    for c in df.columns:
        lc = str(c).lower()

        if contains_all and not all(token.lower() in lc for token in contains_all):
            continue

        if contains_any and not any(token.lower() in lc for token in contains_any):
            continue

        return c

    return None


def find_overall_col(df):
    exact = [
        "overall_yoi_0_100",
        "overall_yoi",
        "yoi_overall_0_100",
        "overall_score",
        "yoi_custom_0_100",
    ]

    col = find_col(df, exact_candidates=exact)
    if col:
        return col

    candidates = []

    for c in df.columns:
        lc = str(c).lower()
        if "overall" in lc and ("yoi" in lc or "score" in lc or "100" in lc):
            candidates.append(c)

    if candidates:
        return candidates[0]

    raise RuntimeError("Could not find an overall YOI score column.")


def find_domain_cols(df):
    out = {}

    for label, candidates in DOMAIN_DEFS.items():
        # First try exact-ish names.
        col = find_col(df, exact_candidates=candidates)

        # Then try a safer aggregate score match.
        if not col:
            possible = []
            for c in df.columns:
                lc = str(c).lower()
                nc = norm(c)

                matched = any(norm(candidate).replace("0100", "") in nc for candidate in candidates)

                if matched and any(term in lc for term in ["0_100", "score", "index"]):
                    numeric = pd.to_numeric(df[c], errors="coerce")
                    if numeric.notna().sum() >= 20:
                        possible.append(c)

            if possible:
                col = possible[0]

        if col:
            out[label] = col

    return out


def pearson(df, x_col, y_col):
    x = pd.to_numeric(df[x_col], errors="coerce")
    y = pd.to_numeric(df[y_col], errors="coerce")
    valid = x.notna() & y.notna()

    if valid.sum() < 25:
        return None, int(valid.sum())

    if x[valid].nunique() < 4 or y[valid].nunique() < 4:
        return None, int(valid.sum())

    r = x[valid].corr(y[valid])

    if pd.isna(r):
        return None, int(valid.sum())

    return float(r), int(valid.sum())


def corr_direction(r):
    if r is None:
        return "not enough data"
    if r >= 0.35:
        return "positive"
    if r <= -0.35:
        return "negative"
    return "weak"


def is_indicator_candidate(col, aggregate_cols):
    lc = str(col).lower()

    if col in aggregate_cols:
        return False

    blocked = [
        "geoid",
        "geometry",
        "objectid",
        "shape",
        "name",
        "rank",
        "percentile",
        "quintile",
        "decile",
        "district",
        "region",
        "zip",
        "tractce",
        "statefp",
        "countyfp",
    ]

    if any(token in lc for token in blocked):
        return False

    # Avoid showing raw population size as a "driver".
    if any(token in lc for token in ["total_pop", "population_total", "youth_pop", "pop_14", "pop_16", "pop_18"]):
        return False

    useful_terms = [
        "0_100",
        "score",
        "index",
        "rate",
        "pct",
        "percent",
        "share",
        "ratio",
        "poverty",
        "income",
        "unemploy",
        "employment",
        "graduat",
        "dropout",
        "school",
        "student",
        "college",
        "rent",
        "housing",
        "vehicle",
        "transit",
        "commute",
        "crime",
        "safety",
        "pollution",
        "asthma",
        "health",
        "insurance",
        "park",
        "service",
        "support",
        "broadband",
    ]

    return any(term in lc for term in useful_terms)


def make_scatter(df, x_col, y_col, title, x_label, y_label, r):
    x = pd.to_numeric(df[x_col], errors="coerce")
    y = pd.to_numeric(df[y_col], errors="coerce")

    name_col = find_col(df, exact_candidates=["name", "tract_name", "label"], contains_any=["name"])
    geoid_col = find_col(df, exact_candidates=["geoid", "tract_geoid", "GEOID", "GEOID20"], contains_any=["geoid"])

    valid = x.notna() & y.notna()
    points = []

    for idx in df[valid].index:
        raw_name = df.loc[idx, name_col] if name_col else None
        raw_geoid = df.loc[idx, geoid_col] if geoid_col else None

        points.append({
            "x": round(float(x.loc[idx]), 3),
            "y": round(float(y.loc[idx]), 3),
            "name": str(raw_name or raw_geoid or f"Tract {idx}"),
        })

    return {
        "title": title,
        "x_label": x_label,
        "y_label": y_label,
        "r": round(float(r), 3) if r is not None else None,
        "points": points,
    }


def main():
    source_file = find_tract_file()
    df = pd.read_csv(source_file)

    overall_col = find_overall_col(df)
    domain_cols = find_domain_cols(df)

    if len(domain_cols) < 3:
        raise RuntimeError(
            f"Only found {len(domain_cols)} domain columns in {source_file}. "
            f"Found: {domain_cols}"
        )

    aggregate_cols = {overall_col, *domain_cols.values()}

    # Domain-to-overall correlations
    domain_to_overall = []

    for domain, col in domain_cols.items():
        r, n = pearson(df, col, overall_col)

        if r is None:
            continue

        domain_to_overall.append({
            "domain": domain,
            "column": col,
            "r": round(r, 3),
            "n": n,
            "direction": corr_direction(r),
        })

    domain_to_overall.sort(key=lambda d: abs(d["r"]), reverse=True)

    # Domain-pair correlations
    domain_pairs = []

    for (d1, c1), (d2, c2) in itertools.combinations(domain_cols.items(), 2):
        r, n = pearson(df, c1, c2)

        if r is None:
            continue

        domain_pairs.append({
            "x_domain": d1,
            "y_domain": d2,
            "x_column": c1,
            "y_column": c2,
            "r": round(r, 3),
            "n": n,
            "direction": corr_direction(r),
        })

    domain_pairs.sort(key=lambda d: abs(d["r"]), reverse=True)

    # Indicator-level correlations with overall YOI
    indicator_corrs = []

    for col in df.columns:
        if not is_indicator_candidate(col, aggregate_cols):
            continue

        numeric = pd.to_numeric(df[col], errors="coerce")

        if numeric.notna().sum() < 25 or numeric.nunique(dropna=True) < 4:
            continue

        r, n = pearson(df, col, overall_col)

        if r is None:
            continue

        indicator_corrs.append({
            "indicator": pretty_label(col),
            "column": col,
            "r": round(r, 3),
            "n": n,
            "direction": corr_direction(r),
        })

    indicator_corrs.sort(key=lambda d: abs(d["r"]), reverse=True)

    top_positive = sorted(
        [d for d in indicator_corrs if d["r"] > 0],
        key=lambda d: d["r"],
        reverse=True
    )[:8]

    top_negative = sorted(
        [d for d in indicator_corrs if d["r"] < 0],
        key=lambda d: d["r"]
    )[:8]

    # Scatter plots
    scatter_plots = []

    if domain_to_overall:
        top_domain = domain_to_overall[0]
        scatter_plots.append(make_scatter(
            df,
            top_domain["column"],
            overall_col,
            f"{top_domain['domain']} score vs overall YOI",
            f"{top_domain['domain']} score",
            "Overall YOI score",
            top_domain["r"],
        ))

    if indicator_corrs:
        top_indicator = indicator_corrs[0]
        scatter_plots.append(make_scatter(
            df,
            top_indicator["column"],
            overall_col,
            f"{top_indicator['indicator']} vs overall YOI",
            top_indicator["indicator"],
            "Overall YOI score",
            top_indicator["r"],
        ))

    strongest_domain = domain_to_overall[0] if domain_to_overall else None
    strongest_pair = domain_pairs[0] if domain_pairs else None
    strongest_indicator = indicator_corrs[0] if indicator_corrs else None

    takeaways = []

    if strongest_domain:
        takeaways.append(
            f"{strongest_domain['domain']} has the strongest domain-level relationship with overall YOI "
            f"(r={strongest_domain['r']})."
        )

    if strongest_pair:
        takeaways.append(
            f"{strongest_pair['x_domain']} and {strongest_pair['y_domain']} move together most strongly "
            f"among domain pairs (r={strongest_pair['r']})."
        )

    if strongest_indicator:
        takeaways.append(
            f"{strongest_indicator['indicator']} has the strongest indicator-level relationship with overall YOI "
            f"(r={strongest_indicator['r']})."
        )

    out = {
        "metadata": {
            "source_file": str(source_file.relative_to(ROOT)),
            "overall_column": overall_col,
            "tract_count": int(len(df)),
            "note": "Pearson correlations across tract-level rows. Correlation is descriptive and does not prove causation.",
        },
        "domain_to_overall": domain_to_overall,
        "domain_pair_correlations": domain_pairs,
        "top_positive_indicators": top_positive,
        "top_negative_indicators": top_negative,
        "scatter_plots": scatter_plots,
        "takeaways": takeaways,
    }

    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(json.dumps(out, indent=2))
    print(f"Wrote {OUT.relative_to(ROOT)}")
    print(f"Source: {source_file.relative_to(ROOT)}")
    print(f"Overall column: {overall_col}")
    print(f"Domain columns: {domain_cols}")


if __name__ == "__main__":
    main()
