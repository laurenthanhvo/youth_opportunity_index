from pathlib import Path
import json
import pandas as pd
import numpy as np
from collections import Counter

YOI_TRACTS = Path("data/processed/yoi/yoi_components.csv")
YOI_REGIONS = Path("data/processed/yoi/yoi_county_region_components.csv")
WORKFORCE_CONTEXT = Path("data/processed/workforce/workforce_context_summary.csv")
OUT_DIR = Path("data/processed/landing")
OUT_DIR.mkdir(parents=True, exist_ok=True)

DOMAIN_COLS = {
    "economic_score": "Economic",
    "education_score": "Education",
    "health_score": "Health",
    "housing_score": "Housing",
    "safety_env_score": "Safety / Env",
    "mobility_connectivity_score": "Mobility / Connectivity",
    "youth_supports_score": "Youth Supports",
}

def clean_num(v):
    try:
        if pd.isna(v):
            return None
        return float(v)
    except Exception:
        return None

def score100(v):
    v = clean_num(v)
    if v is None:
        return None
    return round(v * 100, 1) if v <= 1.01 else round(v, 1)

def fmt_int(v):
    v = clean_num(v)
    if v is None:
        return None
    return int(round(v))

def tract_label(geoid):
    digits = "".join(ch for ch in str(geoid) if ch.isdigit())
    if len(digits) >= 11:
        suffix = digits[-6:]
        return f"Census tract {int(suffix[:4])}.{suffix[4:]}"
    return f"Census tract {geoid}"

def region_label(v):
    s = str(v or "").strip().lower().replace("_", " ")
    if "metro" in s:
        return "Metro San Diego"
    if "north" in s:
        return "North County"
    if "south" in s:
        return "South San Diego"
    if "east" in s:
        return "East San Diego"
    return str(v or "County region")

def get_score_col(df):
    for c in ["yoi_custom_0_100", "yoi_0_100", "overall_yoi_0_100"]:
        if c in df.columns:
            return c
    raise KeyError("Could not find overall YOI score column.")

def lowest_domain(row):
    vals = []
    for col, label in DOMAIN_COLS.items():
        if col in row and pd.notna(row[col]):
            vals.append((float(row[col]), label))
    if not vals:
        return {"domain": "N/A", "score": None}
    val, label = min(vals, key=lambda x: x[0])
    return {"domain": label, "score": score100(val)}

def strongest_domain(row):
    vals = []
    for col, label in DOMAIN_COLS.items():
        if col in row and pd.notna(row[col]):
            vals.append((float(row[col]), label))
    if not vals:
        return {"domain": "N/A", "score": None}
    val, label = max(vals, key=lambda x: x[0])
    return {"domain": label, "score": score100(val)}

def row_to_place(row, score_col):
    low = lowest_domain(row)
    strong = strongest_domain(row)

    domain_scores = {}
    for col, label in DOMAIN_COLS.items():
        if col in row:
            domain_scores[label] = score100(row.get(col))

    return {
        "name": tract_label(row.get("tract_geoid", "")),
        "geoid": str(row.get("tract_geoid", "")),
        "overall_yoi": score100(row.get(score_col)),
        "youth_pop_14_24": fmt_int(row.get("youth_pop_14_24", row.get("total_population", np.nan))),
        "lowest_domain": low["domain"],
        "lowest_domain_score": low["score"],
        "strongest_domain": strong["domain"],
        "strongest_domain_score": strong["score"],
        "domain_scores": domain_scores,
    }

if not YOI_TRACTS.exists():
    raise FileNotFoundError(f"Missing {YOI_TRACTS}")

tracts = pd.read_csv(YOI_TRACTS, dtype={"tract_geoid": str})
score_col = get_score_col(tracts)
tracts["overall_for_sort"] = pd.to_numeric(tracts[score_col], errors="coerce")

if tracts["overall_for_sort"].max(skipna=True) <= 1.01:
    tracts["overall_for_sort"] = tracts["overall_for_sort"] * 100

if "youth_pop_14_24" in tracts.columns:
    tracts["youth_pop_filter"] = pd.to_numeric(tracts["youth_pop_14_24"], errors="coerce")
    landing_tracts = tracts[tracts["youth_pop_filter"].fillna(0) >= 50].copy()
else:
    landing_tracts = tracts.copy()

if landing_tracts.empty:
    landing_tracts = tracts.copy()

top_need = (
    landing_tracts
    .dropna(subset=["overall_for_sort"])
    .sort_values("overall_for_sort", ascending=True)
    .head(5)
)

domain_averages = []
for col, label in DOMAIN_COLS.items():
    if col in tracts.columns:
        values = pd.to_numeric(tracts[col], errors="coerce")
        if values.max(skipna=True) <= 1.01:
            values = values * 100
        domain_averages.append({
            "domain": label,
            "score": round(values.mean(skipna=True), 1),
        })

domain_averages = sorted(domain_averages, key=lambda d: d["score"])

def domain_gap_top(col):
    if col not in landing_tracts.columns:
        return pd.DataFrame()
    temp = landing_tracts.copy()
    temp["domain_for_sort"] = pd.to_numeric(temp[col], errors="coerce")
    if temp["domain_for_sort"].max(skipna=True) <= 1.01:
        temp["domain_for_sort"] = temp["domain_for_sort"] * 100
    return temp.dropna(subset=["domain_for_sort"]).sort_values("domain_for_sort").head(5)

top_youth_support_gap = domain_gap_top("youth_supports_score")
top_economic_gap = domain_gap_top("economic_score")
top_education_gap = domain_gap_top("education_score")

bins = [0, 20, 40, 60, 80, 100]
labels = ["0–20", "20–40", "40–60", "60–80", "80–100"]
distribution = []
for i in range(len(bins) - 1):
    lo, hi = bins[i], bins[i + 1]
    if i == len(bins) - 2:
        count = int(((tracts["overall_for_sort"] >= lo) & (tracts["overall_for_sort"] <= hi)).sum())
    else:
        count = int(((tracts["overall_for_sort"] >= lo) & (tracts["overall_for_sort"] < hi)).sum())
    distribution.append({"range": labels[i], "tract_count": count})

low_opportunity = tracts[tracts["overall_for_sort"] < 40].copy()
bottom_quintile_threshold = tracts["overall_for_sort"].quantile(0.20)
bottom_quintile = tracts[tracts["overall_for_sort"] <= bottom_quintile_threshold].copy()

driver_counts = Counter()
for _, row in bottom_quintile.iterrows():
    driver_counts[lowest_domain(row)["domain"]] += 1

main_driver = driver_counts.most_common(1)[0][0] if driver_counts else "N/A"

youth_total = pd.to_numeric(tracts.get("youth_pop_14_24", pd.Series(dtype=float)), errors="coerce").sum()
youth_low = pd.to_numeric(low_opportunity.get("youth_pop_14_24", pd.Series(dtype=float)), errors="coerce").sum()

metrics = {
    "tract_count": int(len(tracts)),
    "geography_levels": 5,
    "domain_count": 7,
    "total_youth_pop_14_24": fmt_int(youth_total),
    "low_opportunity_tracts": int(len(low_opportunity)),
    "youth_in_low_opportunity_tracts": fmt_int(youth_low),
    "bottom_quintile_main_driver": main_driver,
    "lowest_overall_score": round(tracts["overall_for_sort"].min(skipna=True), 1),
    "median_overall_score": round(tracts["overall_for_sort"].median(skipna=True), 1),
}

region_rows = []
if YOI_REGIONS.exists():
    regions = pd.read_csv(YOI_REGIONS)
    region_score_col = get_score_col(regions)

    for _, row in regions.iterrows():
        name = (
            row.get("county_region")
            or row.get("county_region_id")
            or row.get("region")
            or row.get("region_id")
            or "County region"
        )
        low = lowest_domain(row)
        strong = strongest_domain(row)
        region_rows.append({
            "region": region_label(name),
            "overall_yoi": score100(row.get(region_score_col)),
            "economic": score100(row.get("economic_score")),
            "education": score100(row.get("education_score")),
            "health": score100(row.get("health_score")),
            "housing": score100(row.get("housing_score")),
            "safety_env": score100(row.get("safety_env_score")),
            "mobility_connectivity": score100(row.get("mobility_connectivity_score")),
            "youth_supports": score100(row.get("youth_supports_score")),
            "youth_pop_14_24": fmt_int(row.get("youth_pop_14_24", row.get("total_population", np.nan))),
            "lowest_domain": low["domain"],
            "lowest_domain_score": low["score"],
            "strongest_domain": strong["domain"],
            "strongest_domain_score": strong["score"],
        })

workforce_cards = []
if WORKFORCE_CONTEXT.exists():
    wf = pd.read_csv(WORKFORCE_CONTEXT)
    label_map = {
        "cde_adjusted_cohort_graduation_rate": "Graduation rate",
        "cde_four_year_cohort_dropout_rate": "Dropout rate",
        "cde_homeless_students": "Homeless students",
        "cde_homeless_student_rate": "Homeless student rate",
        "english_learner_students": "English learners",
        "youth_unemployment_rate_16_19_pums": "Youth unemployment 16–19",
        "labor_force_participation_rate_16_19_pums": "Labor force participation 16–19",
    }

    for _, row in wf.iterrows():
        field = row.get("field")
        value = clean_num(row.get("value"))
        if field not in label_map or value is None:
            continue

        if "rate" in field or "unemployment" in field or "participation" in field:
            display = f"{value * 100:.1f}%" if value <= 1 else f"{value:.1f}%"
        else:
            display = f"{int(round(value)):,}"

        workforce_cards.append({
            "label": label_map[field],
            "value": display,
            "source": row.get("source", ""),
        })

insights = {
    "metrics": metrics,
    "top_need_tracts": [row_to_place(row, score_col) for _, row in top_need.iterrows()],
    "top_youth_support_gap_tracts": [row_to_place(row, score_col) for _, row in top_youth_support_gap.iterrows()],
    "top_economic_gap_tracts": [row_to_place(row, score_col) for _, row in top_economic_gap.iterrows()],
    "top_education_gap_tracts": [row_to_place(row, score_col) for _, row in top_education_gap.iterrows()],
    "domain_averages": domain_averages,
    "yoi_distribution": distribution,
    "county_regions": region_rows,
    "workforce_context": workforce_cards,
}

out_path = OUT_DIR / "landing_insights.json"
out_path.write_text(json.dumps(insights, indent=2))
print(f"Saved: {out_path}")
print(json.dumps(metrics, indent=2))
