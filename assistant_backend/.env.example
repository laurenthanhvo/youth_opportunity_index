# Create a free key in Google AI Studio and paste it here.
GEMINI_API_KEY=

# Current low-cost baseline model.
GEMINI_MODEL=gemini-3.5-flash-lite

# Use free while testing with the Gemini free tier; change to paid after enabling billing.
BILLING_MODE=free

# Paths are resolved from the root of your YOI repository.
TRACT_YOI_CSV=data/processed/yoi/yoi_components.csv
REGION_YOI_CSV=data/processed/yoi/yoi_county_region_components.csv
INDICATOR_META_CSV=data/processed/yoi/yoi_indicator_meta.csv
METHODOLOGY_FILE=datasets.html

# Add the origin used by your local frontend.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
