  <script>
    function formatNumber(value) {
      if (value === null || value === undefined || Number.isNaN(Number(value))) return "N/A";
      return Number(value).toLocaleString();
    }

    function metricCard(label, value, note) {
      return `
        <article class="landing-metric-card pro-stat-card">
          <div class="landing-metric-label">${label}</div>
          <div class="landing-metric-value">${value}</div>
          <div class="landing-metric-note">${note}</div>
        </article>
      `;
    }

    function rankItem(item, index) {
      const yoi = item.overall_yoi ?? "N/A";
      const youth = formatNumber(item.youth_pop_14_24);
      const gap = item.lowest_domain ?? "N/A";
      const gapScore = item.lowest_domain_score ?? "N/A";

      return `
        <div class="priority-table-row">
          <div class="priority-table-rank">${index + 1}</div>

          <div class="priority-table-place">
            <strong>${item.name}</strong>
            <span>Lowest overall opportunity ranking</span>
          </div>

          <div class="priority-table-number">
            <span>YOI score</span>
            <strong>${yoi}/100</strong>
          </div>

          <div class="priority-table-number">
            <span>Youth 14–24</span>
            <strong>${youth}</strong>
          </div>

          <div class="priority-table-gap">
            <span>Primary gap</span>
            <strong>${gap}</strong>
            <em>${gapScore}/100</em>
          </div>
        </div>
      `;
    }

    function compactGapItem(item, index, domainLabel) {
      const domainScore = item.domain_scores?.[domainLabel];
      return `
        <div class="landing-rank-item pro-rank-item compact">
          <div class="landing-rank-number">${index + 1}</div>
          <div class="landing-rank-body">
            <div class="landing-rank-title">${item.name}</div>
            <div class="landing-rank-meta">
              ${domainLabel} <strong>${domainScore ?? "N/A"}/100</strong>
              · Overall <strong>${item.overall_yoi ?? "N/A"}/100</strong>
            </div>
          </div>
        </div>
      `;
    }

    function horizontalBar(label, value, note = "") {
      const safeValue = Math.max(0, Math.min(100, Number(value || 0)));
      return `
        <div class="pro-bar-row">
          <div class="pro-bar-top">
            <div>
              <strong>${label}</strong>
              ${note ? `<span>${note}</span>` : ""}
            </div>
            <strong>${value ?? "N/A"}/100</strong>
          </div>
          <div class="pro-bar-track">
            <div class="pro-bar-fill" style="width:${safeValue}%"></div>
          </div>
        </div>
      `;
    }

    function regionBar(region) {
      const note = `
        Youth 14–24: ${formatNumber(region.youth_pop_14_24)}
        · Lowest: ${region.lowest_domain} ${region.lowest_domain_score ?? "N/A"}/100
      `;
      return horizontalBar(region.region, region.overall_yoi, note);
    }

    function domainBar(domain) {
      return horizontalBar(domain.domain, domain.score, "Average tract score");
    }

    let yoiDistributionChart = null;

    function histogram(data) {
      return `
        <div class="chartjs-yoi-wrap">
          <canvas id="yoiDistributionCanvas" aria-label="Opportunity score distribution chart"></canvas>
        </div>
      `;
    }

    function renderYoiDistributionChart(data) {
      const canvas = document.getElementById("yoiDistributionCanvas");
      if (!canvas || !window.Chart) return;

      const labels = data.map(d => d.range);
      const counts = data.map(d => Number(d.tract_count || 0));
      const maxCount = Math.max(...counts, 1);
      const yMax = Math.ceil(maxCount / 100) * 100;

      if (yoiDistributionChart) {
        yoiDistributionChart.destroy();
      }

      yoiDistributionChart = new Chart(canvas, {
        type: "bar",
        data: {
          labels,
          datasets: [{
            label: "Census tracts",
            data: counts,
            backgroundColor: "#246e7e",
            borderColor: "#174f5c",
            borderWidth: 1,
            hoverBackgroundColor: "#2b989e",
            borderRadius: 2,
            barPercentage: 0.62,
            categoryPercentage: 0.72
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 450,
            easing: "easeOutQuart"
          },
          interaction: {
            mode: "index",
            intersect: false
          },
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              backgroundColor: "#072843",
              titleColor: "#ffffff",
              bodyColor: "#ffffff",
              borderColor: "#174f5c",
              borderWidth: 1,
              cornerRadius: 4,
              displayColors: false,
              padding: 10,
              callbacks: {
                title: items => `YOI score range: ${items[0].label}`,
                label: item => `${item.raw.toLocaleString()} Census tracts`
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              suggestedMax: yMax,
              title: {
                display: true,
                text: "Number of Census tracts",
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 12,
                  weight: "700"
                }
              },
              ticks: {
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 12,
                  weight: "700"
                },
                precision: 0
              },
              grid: {
                color: "#d8e1e8",
                lineWidth: 1
              },
              border: {
                color: "#cfd9e2",
                width: 1
              }
            },
            x: {
              title: {
                display: true,
                text: "Overall YOI score range",
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 12,
                  weight: "700"
                }
              },
              ticks: {
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 13,
                  weight: "800"
                }
              },
              grid: {
                display: false
              },
              border: {
                color: "#cfd9e2",
                width: 1
              }
            }
          }
        }
      });
    }


    function normalizeGeoid(value) {
      const digits = String(value || "").replace(/\D/g, "");
      if (!digits) return "";
      return digits.padStart(11, "0").slice(-11);
    }

    function getFeatureGeoid(feature) {
      const p = feature?.properties || {};
      return normalizeGeoid(
        p.tract_geoid ||
        p.GEOID ||
        p.GEOID20 ||
        p.geoid ||
        p.TRACT_GEOID ||
        p.TRACTCE ||
        ""
      );
    }

    async function renderTopTractsMiniMap(topTracts) {
      const container = document.getElementById("topTractsMiniMap");
      const legend = document.getElementById("topTractsMiniMapLegend");

      if (!container || !window.L || !Array.isArray(topTracts) || topTracts.length === 0) {
        return;
      }

      const targetGeoids = new Set(topTracts.map(t => normalizeGeoid(t.geoid)));
      const tractByGeoid = new Map(topTracts.map((t, i) => [normalizeGeoid(t.geoid), { ...t, rank: i + 1 }]));

      const res = await fetch("./data/processed/boundaries/sd_tracts.geojson");
      const geojson = await res.json();

      // Clear old map if the page re-renders.
      if (window.topTractsMiniLeafletMap) {
        window.topTractsMiniLeafletMap.remove();
      }

      const map = L.map("topTractsMiniMap", {
        zoomControl: false,
        attributionControl: false,
        scrollWheelZoom: false,
        dragging: true,
        doubleClickZoom: false,
        boxZoom: false,
        keyboard: false,
        tap: false
      });

      window.topTractsMiniLeafletMap = map;

      // Add visible zoom controls for the mini map.
      L.control.zoom({ position: "topright" }).addTo(map);

      L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
        maxZoom: 18
      }).addTo(map);

      const backgroundLayer = L.geoJSON(geojson, {
        filter: feature => !targetGeoids.has(getFeatureGeoid(feature)),
        style: {
          color: "#94a3b8",
          weight: 0.35,
          opacity: 0.35,
          fillColor: "#dce6ea",
          fillOpacity: 0.12
        },
        interactive: false
      }).addTo(map);

      const highlightLayer = L.geoJSON(geojson, {
        filter: feature => targetGeoids.has(getFeatureGeoid(feature)),
        style: {
          color: "#072843",
          weight: 1.6,
          opacity: 1,
          fillColor: "#e59a22",
          fillOpacity: 0.78
        },
        onEachFeature: (feature, layer) => {
          const geoid = getFeatureGeoid(feature);
          const item = tractByGeoid.get(geoid);

          if (!item) return;

          layer.bindTooltip(
            `<strong>#${item.rank} ${item.name}</strong><br>` +
            `Overall YOI: <strong>${item.overall_yoi}/100</strong><br>` +
            `Main gap: <strong>${item.lowest_domain}</strong>`,
            {
              sticky: true,
              direction: "top",
              className: "mini-map-tooltip"
            }
          );
        }
      }).addTo(map);

      const bounds = highlightLayer.getBounds();

      if (bounds.isValid()) {
        map.fitBounds(bounds.pad(0.16));
      } else {
        map.setView([32.82, -117.05], 10);
      }

      // Fix Leaflet sizing after hidden/layout paint.
      setTimeout(() => {
        map.invalidateSize();
        if (bounds.isValid()) map.fitBounds(bounds.pad(0.16));
      }, 120);

      if (legend) {
        legend.innerHTML = topTracts.map((t, i) => `
          <div class="mini-map-legend-item">
            <span>${i + 1}</span>
            <strong>${t.name}</strong>
            <em>${t.overall_yoi}/100</em>
          </div>
        `).join("");
      }
    }


    function planningSignalForDomain(domain) {
      const d = String(domain || "").toLowerCase();

      if (d.includes("economic")) {
        return "Prioritize workforce, income stability, and employment-access strategies.";
      }

      if (d.includes("youth")) {
        return "Review service coverage, youth programming, and access to wraparound support.";
      }

      if (d.includes("education")) {
        return "Investigate school, enrollment, attainment, and postsecondary pathway barriers.";
      }

      if (d.includes("health")) {
        return "Review health access, health burden, and neighborhood condition indicators.";
      }

      if (d.includes("housing")) {
        return "Review housing affordability, stability, and residential pressure indicators.";
      }

      if (d.includes("mobility")) {
        return "Review transit access, vehicle access, commute burden, and connectivity barriers.";
      }

      if (d.includes("safety")) {
        return "Review safety, environmental burden, and community condition indicators.";
      }

      return "Review the underlying indicators for this region.";
    }

    function regionalActionCard(region) {
      const weakest = region.lowest_domain || "N/A";
      const weakestScore = region.lowest_domain_score ?? "N/A";
      const overall = region.overall_yoi ?? "N/A";

      return `
        <article class="regional-action-card">
          <div class="regional-action-top">
            <div>
              <h3>${region.region}</h3>
              <p>Estimated youth 14–24: <strong>${formatNumber(region.youth_pop_14_24)}</strong></p>
            </div>
            <div class="regional-score">${overall}/100</div>
          </div>

          <div class="regional-action-body">
            <div>
              <span>Weakest domain</span>
              <strong>${weakest}</strong>
              <em>${weakestScore}/100</em>
            </div>

            <p>${planningSignalForDomain(weakest)}</p>
          </div>
        </article>
      `;
    }

    function driverBar(item, maxCount) {
      const count = Number(item.tract_count || 0);
      const width = maxCount ? Math.max(4, (count / maxCount) * 100) : 0;

      return `
        <div class="driver-row" data-tooltip="${count} bottom-quintile tracts have ${item.domain} as their weakest domain">
          <div class="driver-label">${item.domain}</div>
          <div class="driver-track">
            <div class="driver-fill" style="width:${width}%"></div>
          </div>
          <div class="driver-value">${count}</div>
        </div>
      `;
    }

    function evidenceCard(label, value, note) {
      return `
        <div class="evidence-card">
          <span>${label}</span>
          <strong>${value}</strong>
          <p>${note}</p>
        </div>
      `;
    }



    const correlationCharts = {};

    function destroyCorrelationChart(canvasId) {
      if (correlationCharts[canvasId]) {
        correlationCharts[canvasId].destroy();
        delete correlationCharts[canvasId];
      }
    }

    function correlationColor(r) {
      const value = Number(r || 0);
      if (value < 0) return "#e59a22";
      return "#246e7e";
    }

    function correlationLabel(r) {
      const value = Number(r || 0);

      if (value >= 0.6) return "strong positive";
      if (value >= 0.35) return "positive";
      if (value <= -0.6) return "strong negative";
      if (value <= -0.35) return "negative";
      return "weak";
    }

    function shortChartLabel(label, maxLength = 28) {
      const text = String(label || "N/A");
      if (text.length <= maxLength) return text;
      return text.slice(0, maxLength - 1) + "…";
    }

    function renderCorrelationBarChart(canvasId, rows, labelKey, valueKey, xTitle) {
      const canvas = document.getElementById(canvasId);
      if (!canvas || !window.Chart || !Array.isArray(rows) || rows.length === 0) return;

      destroyCorrelationChart(canvasId);

      const labels = rows.map(row => shortChartLabel(row[labelKey]));
      const values = rows.map(row => Number(row[valueKey] || 0));

      correlationCharts[canvasId] = new Chart(canvas, {
        type: "bar",
        data: {
          labels,
          datasets: [{
            data: values,
            backgroundColor: values.map(correlationColor),
            borderColor: values.map(correlationColor),
            borderWidth: 1,
            borderRadius: 3,
            barPercentage: 0.68,
            categoryPercentage: 0.76
          }]
        },
        options: {
          indexAxis: "y",
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 450,
            easing: "easeOutQuart"
          },
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              backgroundColor: "#072843",
              titleColor: "#ffffff",
              bodyColor: "#ffffff",
              borderColor: "#174f5c",
              borderWidth: 1,
              cornerRadius: 4,
              displayColors: false,
              padding: 10,
              callbacks: {
                title: items => rows[items[0].dataIndex][labelKey],
                label: item => {
                  const row = rows[item.dataIndex];
                  const r = Number(row[valueKey] || 0);
                  return `r = ${r.toFixed(3)} (${correlationLabel(r)})`;
                },
                afterLabel: item => {
                  const row = rows[item.dataIndex];
                  return row.n ? `${row.n.toLocaleString()} tracts used` : "";
                }
              }
            }
          },
          scales: {
            x: {
              min: -1,
              max: 1,
              title: {
                display: true,
                text: xTitle || "Correlation with overall YOI",
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 12,
                  weight: "700"
                }
              },
              ticks: {
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 11,
                  weight: "700"
                },
                callback: value => Number(value).toFixed(1)
              },
              grid: {
                color: ctx => ctx.tick.value === 0 ? "#072843" : "#d8e1e8",
                lineWidth: ctx => ctx.tick.value === 0 ? 1.3 : 1
              },
              border: {
                color: "#cfd9e2"
              }
            },
            y: {
              ticks: {
                color: "#0f172a",
                font: {
                  family: "Inter",
                  size: 11,
                  weight: "800"
                }
              },
              grid: {
                display: false
              },
              border: {
                color: "#cfd9e2"
              }
            }
          }
        }
      });
    }

    function renderScatterCorrelationChart(canvasId, scatter) {
      const canvas = document.getElementById(canvasId);
      if (!canvas || !window.Chart || !scatter || !Array.isArray(scatter.points)) return;

      destroyCorrelationChart(canvasId);

      const subtitle = document.getElementById("scatterSubtitle");
      if (subtitle) {
        subtitle.textContent = `${scatter.title}. Each point represents one Census tract. r = ${scatter.r ?? "N/A"}.`;
      }

      correlationCharts[canvasId] = new Chart(canvas, {
        type: "scatter",
        data: {
          datasets: [{
            label: scatter.title,
            data: scatter.points.map(point => ({
              x: Number(point.x),
              y: Number(point.y),
              name: point.name
            })),
            backgroundColor: "rgba(36, 110, 126, 0.55)",
            borderColor: "#174f5c",
            borderWidth: 1,
            pointRadius: 3,
            pointHoverRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: {
            duration: 450,
            easing: "easeOutQuart"
          },
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              backgroundColor: "#072843",
              titleColor: "#ffffff",
              bodyColor: "#ffffff",
              borderColor: "#174f5c",
              borderWidth: 1,
              cornerRadius: 4,
              displayColors: false,
              padding: 10,
              callbacks: {
                title: items => items[0].raw.name || "Census tract",
                label: item => [
                  `${scatter.x_label}: ${Number(item.raw.x).toFixed(1)}`,
                  `${scatter.y_label}: ${Number(item.raw.y).toFixed(1)}`
                ]
              }
            }
          },
          scales: {
            x: {
              title: {
                display: true,
                text: scatter.x_label,
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 12,
                  weight: "700"
                }
              },
              ticks: {
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 11,
                  weight: "700"
                }
              },
              grid: {
                color: "#d8e1e8"
              },
              border: {
                color: "#cfd9e2"
              }
            },
            y: {
              title: {
                display: true,
                text: scatter.y_label,
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 12,
                  weight: "700"
                }
              },
              ticks: {
                color: "#64748b",
                font: {
                  family: "Inter",
                  size: 11,
                  weight: "700"
                }
              },
              grid: {
                color: "#d8e1e8"
              },
              border: {
                color: "#cfd9e2"
              }
            }
          }
        }
      });
    }

    function renderCorrelationCallout(data) {
      const callout = document.getElementById("correlationCallout");
      if (!callout) return;

      const takeaways = data.takeaways || [];
      if (!takeaways.length) {
        callout.innerHTML = "";
        return;
      }

      callout.innerHTML = `
        <div class="correlation-callout-title">What stands out?</div>
        <div class="correlation-callout-list">
          ${takeaways.map(item => `<p>${item}</p>`).join("")}
        </div>
      `;
    }

    async function renderCorrelationInsights() {
      const status = document.getElementById("correlationStatus");
      if (!status) return;

      try {
        const res = await fetch("./data/processed/landing/landing_correlation_insights.json");

        if (!res.ok) {
          throw new Error("Missing landing_correlation_insights.json");
        }

        const data = await res.json();

        const meta = data.metadata || {};
        status.innerHTML = `
          <strong>${formatNumber(meta.tract_count)} Census tracts analyzed.</strong>
          Pearson correlations are calculated from <code>${meta.source_file || "tract-level YOI data"}</code>.
        `;

        renderCorrelationCallout(data);

        const domainRows = data.domain_to_overall || [];
        renderCorrelationBarChart(
          "domainCorrelationCanvas",
          domainRows,
          "domain",
          "r",
          "Correlation with overall YOI"
        );

        const indicatorRows = [
          ...(data.top_positive_indicators || []),
          ...(data.top_negative_indicators || [])
        ]
          .sort((a, b) => Math.abs(Number(b.r || 0)) - Math.abs(Number(a.r || 0)))
          .slice(0, 12);

        renderCorrelationBarChart(
          "indicatorCorrelationCanvas",
          indicatorRows,
          "indicator",
          "r",
          "Correlation with overall YOI"
        );

        const pairRows = (data.domain_pair_correlations || [])
          .map(row => ({
            ...row,
            pair_label: `${row.x_domain} ↔ ${row.y_domain}`
          }))
          .sort((a, b) => Math.abs(Number(b.r || 0)) - Math.abs(Number(a.r || 0)))
          .slice(0, 10);

        renderCorrelationBarChart(
          "domainPairCorrelationCanvas",
          pairRows,
          "pair_label",
          "r",
          "Correlation between domain scores"
        );

        const scatter = (data.scatter_plots || [])[0];
        renderScatterCorrelationChart("scatterCorrelationCanvas", scatter);
      } catch (err) {
        console.error(err);
        status.innerHTML = `
          Could not load correlation insights. Run
          <code>python scripts/build_landing_correlation_insights.py</code>
          and refresh the page.
        `;
      }
    }


    async function loadLandingInsights() {
      const res = await fetch("./data/processed/landing/landing_insights.json");
      const data = await res.json();
      const metrics = data.metrics || {};

      const tractShareBelow40 = metrics.tract_count
        ? (Number(metrics.low_opportunity_tracts || 0) / Number(metrics.tract_count || 1)) * 100
        : 0;

      const youthShareBelow40 = metrics.total_youth_pop_14_24
        ? (Number(metrics.youth_in_low_opportunity_tracts || 0) / Number(metrics.total_youth_pop_14_24 || 1)) * 100
        : 0;

      const executiveSummaryEl = document.getElementById("executiveSummary");

      if (executiveSummaryEl) {
        executiveSummaryEl.innerHTML = `
  <div class="hero-kpi-grid">
    <div class="hero-kpi-card hero-kpi-accent">
      <span class="hero-kpi-label">Tracts below 40</span>
      <strong>${formatNumber(metrics.low_opportunity_tracts)}</strong>
      <small>${tractShareBelow40.toFixed(1)}% of mapped tracts</small>
    </div>

    <div class="hero-kpi-card">
      <span class="hero-kpi-label">Youth affected</span>
      <strong>${formatNumber(metrics.youth_in_low_opportunity_tracts)}</strong>
      <small>${youthShareBelow40.toFixed(1)}% of estimated youth 14–24</small>
    </div>

    <div class="hero-kpi-card">
      <span class="hero-kpi-label">Lowest tract score</span>
      <strong>${metrics.lowest_overall_score ?? "N/A"}/100</strong>
      <small>Most severe observed tract score</small>
    </div>

    <div class="hero-kpi-card hero-kpi-driver">
      <span class="hero-kpi-label">Most common gap driver</span>
      <strong>${metrics.bottom_quintile_main_driver || "N/A"}</strong>
      <small>Most frequent weakest domain in bottom-quintile tracts</small>
    </div>
  </div>
`;
      }

      document.getElementById("landingMetrics").innerHTML = [
        metricCard("Census tracts", formatNumber(metrics.tract_count), "Most detailed neighborhood geography"),
        metricCard("Comparison levels", formatNumber(metrics.geography_levels), "Tracts, ZIPs, regions, supervisor districts, city districts"),
        metricCard("Opportunity domains", formatNumber(metrics.domain_count), "Economic, Education, Health, Housing, Safety / Env, Mobility, Youth Supports"),
        metricCard("Youth 14–24", formatNumber(metrics.total_youth_pop_14_24), "Estimated youth population represented in tract data")
      ].join("");

      const topNeedTracts = data.top_need_tracts || [];

      const topNeedListEl = document.getElementById("topNeedList");
      topNeedListEl.classList.add("priority-table");
      topNeedListEl.innerHTML = `
        <div class="priority-table-header">
          <div>Rank</div>
          <div>Census tract</div>
          <div>YOI</div>
          <div>Youth</div>
          <div>Primary gap</div>
        </div>
        ${topNeedTracts.map(rankItem).join("")}
      `;

      requestAnimationFrame(() => {
        renderTopTractsMiniMap(topNeedTracts);
      });

      const yoiDistributionData = data.yoi_distribution || [];
      document.getElementById("distributionChart").innerHTML = histogram(yoiDistributionData);
      requestAnimationFrame(() => renderYoiDistributionChart(yoiDistributionData));

      const regions = data.county_regions || [];
      const regionalActionGrid = document.getElementById("regionalActionGrid");

      if (regionalActionGrid) {
        regionalActionGrid.innerHTML = regions
          .sort((a, b) => (a.overall_yoi || 0) - (b.overall_yoi || 0))
          .map(regionalActionCard)
          .join("");
      }

      const driverData = data.bottom_quintile_driver_counts || [];
      const driverBarsEl = document.getElementById("driverBars");

      if (driverBarsEl) {
        const maxDriverCount = Math.max(...driverData.map(d => Number(d.tract_count || 0)), 1);
        driverBarsEl.innerHTML = driverData.map(d => driverBar(d, maxDriverCount)).join("");
      }

      const whyEl = document.getElementById("whyDashboardMatters");

      if (whyEl) {
        whyEl.innerHTML = [
          evidenceCard(
            "Tracts below 40/100",
            formatNumber(metrics.low_opportunity_tracts),
            "These are the clearest low-opportunity geographies flagged by the dashboard."
          ),
          evidenceCard(
            "Youth in tracts below 40/100",
            formatNumber(metrics.youth_in_low_opportunity_tracts),
            "This estimates the number of youth ages 14–24 living in the most concerning areas."
          ),
          evidenceCard(
            "Most common bottom-quintile driver",
            metrics.bottom_quintile_main_driver || "N/A",
            "This identifies the domain most often driving low opportunity among the lowest-scoring tracts."
          ),
          evidenceCard(
            "Lowest observed tract score",
            `${metrics.lowest_overall_score ?? "N/A"}/100`,
            "This shows the most severe local opportunity gap currently visible in the dashboard."
          )
        ].join("");
      }

      document.getElementById("workforceCards").innerHTML =
        (data.workforce_context || [])
          .map(card => metricCard(card.label, card.value, card.source || "Countywide benchmark"))
          .join("");

      await renderCorrelationInsights();
    }

    loadLandingInsights().catch(err => {
      console.error(err);
      document.getElementById("landingMetrics").innerHTML =
        "<div class='landing-loading'>Could not load landing insights. Run scripts/build_landing_insights.py first.</div>";
    });
  </script>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</body>
</html>
